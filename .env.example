# ===================================================
# FAUTEO - Variables d'environnement
# Copier en .env.local. En local, `npm run db:start` affiche les valeurs Supabase.
# ===================================================

# 1. Supabase (PostgreSQL + PostGIS + Auth + Storage) — projet en région UE (RGPD)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Serveur uniquement : contourne les RLS (webhooks, tâches planifiées). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Stripe Connect (place de marché)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 3. Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
